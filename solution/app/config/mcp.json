{
  "mcpServers": {
    "shopflow-sqlite": {
      "command": "uvx",
      "args": ["--default-index", "https://packagefeedproxy.microsoft.io/pypi/simple/", "--with", "mcp<2.0", "mcp-server-sqlite", "--db-path", "${SHOPFLOW_DB}"],
      "transport": "stdio"
    },
    "datapilot-dq": {
      "command": "python",
      "args": ["solution/mcp_servers/dq_server.py", "${SHOPFLOW_DB}"],
      "transport": "stdio"
    },
    "datapilot-rag": {
      "command": "python",
      "args": ["solution/mcp_servers/rag_server.py"],
      "transport": "stdio"
    }
  }
}
