{
  "mcpServers": {
    "shopflow-sqlite": {
      "command": "mcp-server-sqlite",
      "args": ["--db-path", "${SHOPFLOW_DB}"],
      "transport": "stdio"
    },
    "datapilot-dq": {
      "command": "python",
      "args": ["solution/mcp_servers/dq_server.py", "${SHOPFLOW_DB}"],
      "transport": "stdio"
    },
    "datapilot-rag": {
      "command": "python",
      "args": ["solution/mcp_servers/rag_server.py"],
      "transport": "stdio"
    }
  }
}
